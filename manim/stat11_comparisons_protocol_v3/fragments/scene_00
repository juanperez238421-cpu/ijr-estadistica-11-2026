#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Statistics 11 — Python comparison operators in Google Colab.

Protocol V3: senior visual/pedagogical revision.

Primary focus
-------------
Turn a statistical data question into a Python comparison, execute it in a
Colab-style code cell, read the Boolean result, and interpret that result in
context.

Visual contract
---------------
- JP classroom style: white background, black text, neutral gray hierarchy.
- 1920x1080, 16:9, 30 fps.
- Standard opening, numbered headers, safe content zone and standard closing.
- Large projection-safe typography; no decorative color dependence.
- One central idea per screen; code is written progressively.
- Colab is represented by a minimal code-cell abstraction, not a dense UI mockup.
- Camera emphasis is brief and only used after the full object is readable.

Pedagogical route
-----------------
DATA -> QUESTION -> OPERATOR -> RUN -> TRUE/FALSE -> INTERPRET

Target: Manim Community Edition 0.20.1
"""

from __future__ import annotations

from library.jp_classroom_style import *


SCORES = [4.2, 2.8, 3.0, 4.5, 3.7]
PASS_MARK = 3.0
A_VALUE = 12
B_VALUE = 18


class Stat11ComparisonsProtocolV3(JPMathClassroomScene):
    """Protocol-first lesson on comparison operators for Statistics 11."""

    # ------------------------------------------------------------------
    # Data validation
    # ------------------------------------------------------------------
    def validate_lesson_data(self) -> None:
        assert SCORES == [4.2, 2.8, 3.0, 4.5, 3.7]
        assert PASS_MARK == 3.0
        assert (SCORES[0] >= PASS_MARK) is True
        assert (SCORES[1] < PASS_MARK) is True
        assert (SCORES[2] == PASS_MARK) is True
        assert (SCORES[0] != 4.2) is False
        assert (SCORES[3] > SCORES[1]) is True
        assert (A_VALUE < B_VALUE) is True
        assert (A_VALUE != B_VALUE) is True
        assert (A_VALUE >= B_VALUE) is False

    # ------------------------------------------------------------------
    # Lesson-specific visual helpers
    # ------------------------------------------------------------------
    def mono(self, content: str, size: int = 28, weight=MEDIUM) -> Text:
        return self.text(content, size, weight, font="DejaVu Sans Mono")

    def data_card(self, label: str, value: str, *, width: float = 3.35) -> VGroup:
        label_mob = self.text(label, 22, BOLD)
        value_mob = self.mono(value, 38, BOLD)
        content = VGroup(label_mob, value_mob).arrange(DOWN, buff=0.12)
        box = RoundedRectangle(
            width=width,
            height=1.48,
            corner_radius=0.12,
            stroke_color=BLACK_LINE,
            stroke_width=1.9,
            fill_color=WHITE_FILL,
            fill_opacity=1.0,
        )
        content.move_to(box)
        return VGroup(box, content)

    def result_badge(self, result: str, *, width: float = 2.65) -> VGroup:
        box = RoundedRectangle(
            width=width,
            height=0.92,
            corner_radius=0.12,
            stroke_color=BLACK_LINE,
            stroke_width=2.0,
            fill_color=PAPER_GRAY,
            fill_opacity=1.0,
        )
        text = self.mono(result, 34, BOLD).move_to(box)
        return VGroup(box, text)

    def code_cell(
        self,
        lines: list[str],
        *,
        width: float = 9.8,
        line_size: int = 28,
        min_height: float = 1.65,
        exec_label: str = "[ ]",
    ) -> VGroup:
        """Minimal Colab-style cell consistent with the classroom format."""
        line_mobs = VGroup(*[self.mono(line, line_size) for line in lines])
        line_mobs.arrange(DOWN, aligned_edge=LEFT, buff=0.18)
        self.fit(line_mobs, width - 1.65, 3.15)
        height = max(min_height, line_mobs.height + 0.62)

        box = RoundedRectangle(
            width=width,
            height=height,
            corner_radius=0.10,
            stroke_color=LIGHT_GRAY,
