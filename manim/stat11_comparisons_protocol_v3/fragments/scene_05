        number: int,
        question: str,
        expression: str,
        result_text: str,
        interpretation: str,
        *,
        exec_number: int,
    ) -> None:
        prompt = self.prompt_panel(number, question, expression)
        prompt.move_to(UP * 0.68)
        think = self.text("THINK FIRST: True or False?", 29, BOLD)
        think.next_to(prompt, DOWN, buff=0.36)

        self.assert_content_safe(VGroup(prompt, think), f"workshop prompt {number}")
        self.play(FadeIn(prompt, shift=UP * 0.10), run_time=RUN_NORMAL)
        self.play(Write(think), run_time=RUN_SLOW)
        self.wait(PAUSE_WORK)

        cell = self.code_cell([expression], width=8.4, line_size=31, min_height=1.45)
        cell.next_to(think, DOWN, buff=0.42)
        self.type_code_cell(cell, line_time=1.05)
        self.execute_cell(cell, exec_number)

        output = self.output_block([result_text], width=3.8, line_size=31)
        output.next_to(cell, DOWN, aligned_edge=LEFT, buff=0.22)
        self.reveal_output(output, pause=PAUSE_READ)

        interpretation_panel = self.note_panel(
            "INTERPRETATION",
            [interpretation],
            width=6.4,
            title_size=24,
            body_size=23,
        )
        interpretation_panel.next_to(output, RIGHT, buff=0.42)
        self.assert_content_safe(VGroup(cell, output, interpretation_panel), f"workshop answer {number}")
        self.play(FadeIn(interpretation_panel, shift=LEFT * 0.10), run_time=RUN_NORMAL)
        self.wait(PAUSE_WORK)

    # ------------------------------------------------------------------
    # Scene 08 — summary
    # ------------------------------------------------------------------
    def summary(self) -> None:
        self.set_header(
            8,
            "TAKEAWAY",
            "Comparison operators convert data questions into Boolean results that Python can store and use later.",
        )

        route = self.process_map(
            [
                ("1", "READ THE DATA"),
                ("2", "WRITE THE QUESTION"),
                ("3", "RUN THE COMPARISON"),
                ("4", "INTERPRET THE BOOLEAN"),
            ],
            card_width=5.5,
            card_height=1.18,
            columns=2,
        )
        route.move_to(DOWN * 0.20)
        self.assert_content_safe(route, "scene 08 route")

        self.play(LaggedStart(*[FadeIn(card, shift=UP * 0.10) for card in route], lag_ratio=0.16), run_time=RUN_SLOW * 1.5)
        self.wait(PAUSE_WORK)

        operators = self.mono(">   <   >=   <=   ==   !=", 34, BOLD)
        operators.next_to(route, DOWN, buff=0.40)
        bridge = self.mono("comparison  →  True / False  →  later: conditions and filtering", 25, BOLD)
        bridge.next_to(operators, DOWN, buff=0.30)
        self.fit(bridge, 13.7, 0.72)
        self.assert_content_safe(VGroup(operators, bridge), "scene 08 final bridge")

        self.play(Write(operators), run_time=RUN_SLOW)
        self.wait(PAUSE_READ)
        self.play(Write(bridge), run_time=RUN_SLOW)
        self.wait(PAUSE_FINAL)
        self.standard_closing(
            "A comparison asks a precise question about data — and Python answers True or False."
        )


