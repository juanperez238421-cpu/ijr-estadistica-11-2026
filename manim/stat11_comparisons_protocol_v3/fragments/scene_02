            stroke_width=1.6,
            fill_color=VERY_LIGHT_GRAY,
            fill_opacity=1.0,
        )
        badge_text = self.text(str(number), 22, BOLD).move_to(badge)
        q = self.text(question, 26, BOLD)
        expr = self.mono(expression, 27, MEDIUM)
        text_group = VGroup(q, expr).arrange(DOWN, aligned_edge=LEFT, buff=0.12)
        content = VGroup(VGroup(badge, badge_text), text_group).arrange(RIGHT, buff=0.28)
        box = RoundedRectangle(
            width=12.9,
            height=1.62,
            corner_radius=0.12,
            stroke_color=LIGHT_GRAY,
            stroke_width=1.5,
            fill_color=WHITE_FILL,
            fill_opacity=1.0,
        )
        self.fit(content, 12.25, 1.35)
        content.move_to(box)
        content.align_to(box, LEFT).shift(RIGHT * 0.34)
        return VGroup(box, content)

