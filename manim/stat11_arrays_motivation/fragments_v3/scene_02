                indexes.add(idx)
        boxes.arrange(RIGHT, buff=0.10)
        for i, (box, value_mob) in enumerate(zip(boxes, values_group)):
            value_mob.move_to(box)
            if show_indexes:
                indexes[i].next_to(box, DOWN, buff=0.10)
        label.next_to(boxes, LEFT, buff=0.24)
        arrow = Arrow(label.get_right(), boxes.get_left(), buff=0.08, stroke_width=2.0, color=BLACK_LINE)
        group = VGroup(label, arrow, boxes, values_group)
        if show_indexes:
            index_label = self.text("index", 17, MEDIUM)
            index_label.next_to(indexes, LEFT, buff=0.16)
            group.add(indexes, index_label)
        return group

    def advantage_cards(self) -> VGroup:
        cards = self.process_map(
            [
                ("1", "ONE NAME FOR THE WHOLE DATASET"),
                ("2", "VALUES STAY TOGETHER AND IN ORDER"),
                ("3", "EASIER TO ACCESS: data[0], data[1], ..."),
                ("4", "BETTER FOR REAL DATA COLLECTION"),
            ],
            card_width=6.2,
            card_height=1.10,
            columns=2,
        )
        return cards

