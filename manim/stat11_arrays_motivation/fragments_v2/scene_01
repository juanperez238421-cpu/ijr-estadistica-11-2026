            ],
            width=5.6,
            title_size=23,
            body_size=22,
        )
        right = VGroup(strip, reflection).arrange(DOWN, buff=0.42)
        body = self.split_layout(cell, right, center_y=-0.95)
        self.assert_content_safe(VGroup(prompt, body.group), "need for structure")

        self.play(FadeIn(prompt), run_time=RUN_NORMAL)
        self.wait(PAUSE_READ)
        self.play(FadeIn(cell), run_time=RUN_NORMAL)
        self.wait(PAUSE_EXPLAIN)
        self.play(FadeIn(strip), run_time=RUN_NORMAL)
        self.wait(PAUSE_READ)
        self.play(FadeIn(reflection), run_time=RUN_NORMAL)
        self.wait(PAUSE_WORK)
        self.clear_stage()

        self.set_header(
            2,
            "THE REAL ISSUE IS ORGANIZATION",
            "Separate variables are possible, but they do not describe the dataset in a natural way.",
        )
        cards = self.process_map(
            [
                ("1", "30 students → 30 variable names"),
                ("2", "The code grows too much"),
                ("3", "It becomes harder to read"),
                ("4", "The data no longer looks grouped"),
            ],
            card_width=5.8,
            card_height=1.10,
            columns=2,
        )
        cards.move_to(DOWN * 0.1)
        sentence = self.formula_panel(
            r"\text{We need one structure for many related values}",
            width=9.0,
            height=1.05,
            font_size=36,
        )
        sentence.move_to(DOWN * 3.32)
