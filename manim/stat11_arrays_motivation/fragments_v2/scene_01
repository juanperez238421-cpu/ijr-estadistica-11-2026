            index_label = self.text("index", 17, MEDIUM)
            index_label.next_to(indexes, LEFT, buff=0.16)
            group.add(indexes, index_label)
        return group

    def prompt_card(
        self,
        number: str,
        prompt: str,
        *,
        width: float = 6.4,
        body_size: int = 25,
    ) -> VGroup:
        """Numbered classroom prompt card used for workshop tasks."""
        badge = RoundedRectangle(
            width=0.64,
            height=0.52,
            corner_radius=0.09,
            stroke_color=BLACK_LINE,
            stroke_width=1.6,
            fill_color=VERY_LIGHT_GRAY,
            fill_opacity=1.0,
        )
        badge_text = self.text(number, 20, BOLD).move_to(badge)
        body = self.text(prompt, body_size, MEDIUM)
        self.fit(body, width - 1.35, 1.15)
        row = VGroup(VGroup(badge, badge_text), body).arrange(RIGHT, buff=0.20)
        box = RoundedRectangle(
            width=width,
            height=max(1.05, row.height + 0.42),
            corner_radius=0.10,
            stroke_color=BLACK_LINE,
            stroke_width=1.5,
            fill_color=WHITE_FILL,
            fill_opacity=1.0,
        )
        row.move_to(box).align_to(box, LEFT).shift(RIGHT * 0.22)
        return VGroup(box, row)

    def advantage_cards(self) -> VGroup:
        cards = self.process_map(
            [
