        self.play(LaggedStart(*[FadeIn(card) for card in cards], lag_ratio=0.12), run_time=RUN_SLOW * 1.7)
        self.wait(PAUSE_WORK)
        self.play(FadeIn(sentence), run_time=RUN_NORMAL)
        self.wait(PAUSE_SUMMARY)
        self.clear_stage()

