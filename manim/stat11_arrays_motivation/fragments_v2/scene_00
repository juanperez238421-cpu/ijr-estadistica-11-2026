    def colab_cell(
        self,
        lines: list[str],
        *,
        cell_id: str = "1",
        width: float = 7.6,
        title: str | None = None,
        line_size: int = 25,
        min_height: float = 1.7,
    ) -> VGroup:
        """Colab-like code cell with left gutter and optional title."""
        prompt_box = RoundedRectangle(
            width=0.95,
            height=0.62,
            corner_radius=0.10,
            stroke_color=BLACK_LINE,
            stroke_width=1.4,
            fill_color=VERY_LIGHT_GRAY,
            fill_opacity=1.0,
        )
        prompt = self.text(f"In [{cell_id}]", 20, BOLD).move_to(prompt_box)
        prompt_group = VGroup(prompt_box, prompt)

        code_lines = VGroup(*[self.text(line, line_size, MEDIUM) for line in lines])
        code_lines.arrange(DOWN, aligned_edge=LEFT, buff=0.14)

        if title:
            title_mob = self.text(title, 20, BOLD)
            content = VGroup(title_mob, code_lines).arrange(DOWN, aligned_edge=LEFT, buff=0.18)
        else:
            content = code_lines

        content_box = RoundedRectangle(
            width=width,
            height=max(min_height, content.height + 0.48),
            corner_radius=0.10,
            stroke_color=LIGHT_GRAY,
            stroke_width=1.8,
            fill_color=WHITE_FILL,
            fill_opacity=1.0,
        )
        self.fit(content, width - 0.45, 4.65)
        content.move_to(content_box).align_to(content_box, LEFT).shift(RIGHT * 0.24)

        cell_body = VGroup(content_box, content)
        row = VGroup(prompt_group, cell_body).arrange(RIGHT, buff=0.22, aligned_edge=UP)
        return row

    def colab_output(
        self,
        lines: list[str],
        *,
        width: float = 7.3,
        line_size: int = 24,
        tag: str = "Out"
    ) -> VGroup:
        tag_box = RoundedRectangle(
            width=0.88,
            height=0.56,
            corner_radius=0.09,
            stroke_color=BLACK_LINE,
            stroke_width=1.3,
            fill_color=PAPER_GRAY,
            fill_opacity=1.0,
        )
        tag_text = self.text(tag, 19, BOLD).move_to(tag_box)
        tag_group = VGroup(tag_box, tag_text)

        output_lines = VGroup(*[self.text(line, line_size, MEDIUM) for line in lines])
        output_lines.arrange(DOWN, aligned_edge=LEFT, buff=0.12)
        output_box = RoundedRectangle(
            width=width,
            height=max(1.0, output_lines.height + 0.42),
            corner_radius=0.10,
            stroke_color=LIGHT_GRAY,
            stroke_width=1.5,
            fill_color=PAPER_GRAY,
            fill_opacity=1.0,
        )
        self.fit(output_lines, width - 0.45, 3.1)
        output_lines.move_to(output_box).align_to(output_box, LEFT).shift(RIGHT * 0.24)

        output_body = VGroup(output_box, output_lines)
        return VGroup(tag_group, output_body).arrange(RIGHT, buff=0.22, aligned_edge=UP)

    def notebook_panel(self, title: str, subtitle: str, body: Mobject, *, width: float = 14.2) -> VGroup:
        header = VGroup(
            self.text(title, 25, BOLD),
            self.text(subtitle, 18, MEDIUM),
        ).arrange(DOWN, aligned_edge=LEFT, buff=0.10)

        panel = RoundedRectangle(
            width=width,
            height=max(4.1, body.height + 1.35),
            corner_radius=0.14,
            stroke_color=BLACK_LINE,
            stroke_width=1.8,
            fill_color=WHITE_FILL,
            fill_opacity=1.0,
        )
        divider = Line(LEFT * (width / 2 - 0.20), RIGHT * (width / 2 - 0.20), color=LIGHT_GRAY, stroke_width=1.6)
        divider.next_to(header, DOWN, buff=0.20)
        content = VGroup(header, divider, body).arrange(DOWN, aligned_edge=LEFT, buff=0.22)
        self.fit(content, width - 0.55, 5.1)
        content.move_to(panel).align_to(panel, UP).shift(DOWN * 0.18)
        content.align_to(panel, LEFT).shift(RIGHT * 0.28)
        group = VGroup(panel, content)
        return group

