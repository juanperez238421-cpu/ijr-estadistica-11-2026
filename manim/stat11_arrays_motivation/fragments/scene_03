    def summary(self) -> None:
        self.set_header(
            7,
            "THE IDEA TO TAKE INTO COLAB",
            "Use the structure that matches the problem: one value can use one variable; related ordered values belong together.",
        )

        route = self.process_map(
            [
                ("1", "ONE VALUE → VARIABLE"),
                ("2", "MANY RELATED VALUES → LIST"),
                ("3", "ORDER → INDEX"),
            ],
            card_width=4.45,
            card_height=1.25,
            columns=3,
        )
        route.move_to(UP * 0.85)

        final_code = self.code_panel(
            [
                "data = [value0, value1, value2, ...]",
                "data[0]  # first value",
                "data[1]  # second value",
            ],
            width=8.8,
            title="THE PATTERN",
            line_size=27,
            min_height=2.75,
        )
        final_code.move_to(DOWN * 1.10)
        self.assert_content_safe(VGroup(route, final_code), "summary layout")

        self.play(
            LaggedStart(*[FadeIn(card, shift=UP * 0.10) for card in route], lag_ratio=0.14),
            run_time=RUN_SLOW * 1.7,
        )
        self.wait(PAUSE_WORK)
        self.play(FadeIn(final_code), run_time=RUN_NORMAL)
        self.wait(PAUSE_FINAL)
        self.standard_closing(
            "A list is not more data. It is a better structure for related data."
        )


